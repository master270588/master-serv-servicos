generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String?                @unique
  phone               String?                @unique
  passwordHash        String                 @map("password_hash")
  status              String                 @default("pending")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime               @default(now()) @map("updated_at") @db.Timestamptz
  roles               UserRole[]
  provider            ProviderProfile?
  sessions            AuthSession[]
  auditEvents         AuditEvent[]           @relation("AuditActor")
  customerOrders      ServiceOrder[]         @relation("OrderCustomer")
  addresses           CustomerAddress[]
  reviewedDocuments   ProviderDocument[]     @relation("DocumentReviewer")
  assignedOrders      OrderAssignment[]      @relation("AssignmentActor")
  customerPayments    PaymentTransaction[]   @relation("PaymentCustomer")
  privacyConsents     PrivacyConsent[]
  notifications       Notification[]
  loyaltyAccount      LoyaltyAccount?
  loyaltyEntries      LoyaltyLedger[]

  @@map("app_users")
}

model Role {
  id    Int        @id @default(autoincrement()) @db.SmallInt
  code  String     @unique
  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     Int      @map("role_id") @db.SmallInt
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model ProviderProfile {
  userId             String                @id @map("user_id") @db.Uuid
  displayName        String                @map("display_name")
  approvalStatus     String                @default("pending") @map("approval_status")
  bio                String?
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz
  user               AppUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services           ProviderService[]
  documents          ProviderDocument[]
  quotes             Quote[]
  dispatchCandidates DispatchCandidate[]
  assignments        OrderAssignment[]
  providerPayments   PaymentTransaction[]  @relation("PaymentProvider")

  @@map("provider_profiles")
}

model ServiceCategory {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String            @unique
  active           Boolean           @default(true)
  providerServices ProviderService[]
  orders           ServiceOrder[]

  @@map("service_categories")
}

model ProviderService {
  providerUserId String          @map("provider_user_id") @db.Uuid
  categoryId     String          @map("category_id") @db.Uuid
  provider       ProviderProfile @relation(fields: [providerUserId], references: [userId], onDelete: Cascade)
  category       ServiceCategory @relation(fields: [categoryId], references: [id])

  @@id([providerUserId, categoryId])
  @@map("provider_services")
}

model ServiceOrder {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerUserId String                 @map("customer_user_id") @db.Uuid
  categoryId     String                 @map("category_id") @db.Uuid
  description    String
  city           String
  status         String                 @default("requested")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime               @default(now()) @map("updated_at") @db.Timestamptz
  customer       AppUser                @relation("OrderCustomer", fields: [customerUserId], references: [id])
  category       ServiceCategory        @relation(fields: [categoryId], references: [id])
  quotes         Quote[]
  dispatchBatches DispatchBatch[]
  assignments   OrderAssignment[]
  payments      PaymentTransaction[]
  ledgerEntries FinancialLedgerEntry[]
  commission    CommissionRecord?
  loyaltyEntries LoyaltyLedger[]

  @@index([customerUserId, createdAt(sort: Desc)], map: "idx_orders_customer_created")
  @@index([status, createdAt], map: "idx_orders_status_created")
  @@map("service_orders")
}

model Quote {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String          @map("order_id") @db.Uuid
  providerUserId  String          @map("provider_user_id") @db.Uuid
  amountCents     BigInt          @map("amount_cents")
  status          String          @default("submitted")
  submittedAt     DateTime        @default(now()) @map("submitted_at") @db.Timestamptz
  customerDecidedAt DateTime?     @map("customer_decided_at") @db.Timestamptz
  order           ServiceOrder    @relation(fields: [orderId], references: [id])
  provider        ProviderProfile @relation(fields: [providerUserId], references: [userId])

  @@index([orderId, status], map: "idx_quotes_order_status")
  @@map("quotes")
}

model AuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  actor       AppUser? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_events")
}

model CustomerAddress {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerUserId String   @map("customer_user_id") @db.Uuid
  label          String?
  postalCode     String   @map("postal_code")
  street         String
  number         String
  complement     String?
  neighborhood   String
  city           String
  stateCode      String   @default("ES") @map("state_code") @db.Char(2)
  referenceNote  String?  @map("reference_note")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz
  customer       AppUser  @relation(fields: [customerUserId], references: [id], onDelete: Cascade)

  @@index([customerUserId], map: "idx_customer_addresses_owner")
  @@map("customer_addresses")
}

model ProviderDocument {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerUserId   String          @map("provider_user_id") @db.Uuid
  documentType     String          @map("document_type")
  storageKey       String          @unique @map("storage_key")
  originalFilename String          @map("original_filename")
  mimeType         String          @map("mime_type")
  sizeBytes        BigInt          @map("size_bytes")
  reviewStatus     String          @default("pending") @map("review_status")
  expiresAt        DateTime?       @map("expires_at") @db.Date
  reviewedBy       String?         @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?       @map("reviewed_at") @db.Timestamptz
  rejectionReason  String?         @map("rejection_reason")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  provider         ProviderProfile @relation(fields: [providerUserId], references: [userId], onDelete: Cascade)
  reviewer         AppUser?        @relation("DocumentReviewer", fields: [reviewedBy], references: [id])

  @@index([providerUserId, reviewStatus], map: "idx_provider_documents_review")
  @@map("provider_documents")
}

model DispatchBatch {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String              @map("order_id") @db.Uuid
  mode      String
  status    String              @default("open")
  expiresAt DateTime?           @map("expires_at") @db.Timestamptz
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz
  order     ServiceOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  candidates DispatchCandidate[]

  @@map("dispatch_batches")
}

model DispatchCandidate {
  batchId        String          @map("batch_id") @db.Uuid
  providerUserId String          @map("provider_user_id") @db.Uuid
  responseStatus String         @default("pending") @map("response_status")
  respondedAt    DateTime?       @map("responded_at") @db.Timestamptz
  batch          DispatchBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  provider       ProviderProfile @relation(fields: [providerUserId], references: [userId])

  @@id([batchId, providerUserId])
  @@index([providerUserId, responseStatus], map: "idx_dispatch_candidates_provider")
  @@map("dispatch_candidates")
}

model OrderAssignment {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  providerUserId String          @map("provider_user_id") @db.Uuid
  assignedBy     String?         @map("assigned_by") @db.Uuid
  status         String          @default("assigned")
  assignedAt     DateTime        @default(now()) @map("assigned_at") @db.Timestamptz
  endedAt        DateTime?       @map("ended_at") @db.Timestamptz
  order          ServiceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       ProviderProfile @relation(fields: [providerUserId], references: [userId])
  actor          AppUser?        @relation("AssignmentActor", fields: [assignedBy], references: [id])

  @@index([orderId, assignedAt(sort: Desc)], map: "idx_assignments_order")
  @@index([providerUserId, status], map: "idx_assignments_provider")
  @@map("order_assignments")
}

model PaymentTransaction {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String                @map("order_id") @db.Uuid
  customerUserId    String                @map("customer_user_id") @db.Uuid
  providerUserId    String?               @map("provider_user_id") @db.Uuid
  method             String
  status             String                @default("pending")
  amountCents        BigInt                @map("amount_cents")
  providerReference String?               @map("provider_reference")
  idempotencyKey    String                @unique @map("idempotency_key")
  paidAt            DateTime?             @map("paid_at") @db.Timestamptz
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz
  order             ServiceOrder          @relation(fields: [orderId], references: [id])
  customer          AppUser               @relation("PaymentCustomer", fields: [customerUserId], references: [id])
  provider          ProviderProfile?      @relation("PaymentProvider", fields: [providerUserId], references: [userId])
  ledgerEntries     FinancialLedgerEntry[]
  commission        CommissionRecord?

  @@index([orderId, createdAt(sort: Desc)], map: "idx_payments_order")
  @@map("payment_transactions")
}

model FinancialLedgerEntry {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId  String?            @map("transaction_id") @db.Uuid
  orderId        String             @map("order_id") @db.Uuid
  entryType      String             @map("entry_type")
  direction      String
  amountCents    BigInt             @map("amount_cents")
  description    String
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  transaction   PaymentTransaction? @relation(fields: [transactionId], references: [id])
  order          ServiceOrder       @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt], map: "idx_ledger_order")
  @@map("financial_ledger_entries")
}

model CommissionRecord {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String              @unique @map("order_id") @db.Uuid
  paymentTransactionId  String?             @unique @map("payment_transaction_id") @db.Uuid
  grossAmountCents      BigInt              @map("gross_amount_cents")
  rateBasisPoints       Int                 @default(1000) @map("rate_basis_points")
  commissionAmountCents BigInt              @map("commission_amount_cents")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  order                 ServiceOrder        @relation(fields: [orderId], references: [id])
  paymentTransaction    PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])

  @@map("commission_records")
}

model LoyaltyAccount {
  customerUserId String   @id @map("customer_user_id") @db.Uuid
  balancePoints  BigInt   @default(0) @map("balance_points")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz
  customer       AppUser  @relation(fields: [customerUserId], references: [id], onDelete: Cascade)

  @@map("loyalty_accounts")
}

model LoyaltyLedger {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerUserId String       @map("customer_user_id") @db.Uuid
  orderId        String?      @map("order_id") @db.Uuid
  pointsDelta    BigInt       @map("points_delta")
  description    String
  idempotencyKey String       @unique @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  customer       AppUser      @relation(fields: [customerUserId], references: [id])
  order          ServiceOrder? @relation(fields: [orderId], references: [id])

  @@index([customerUserId, createdAt(sort: Desc)], map: "idx_loyalty_ledger_customer")
  @@map("loyalty_ledger")
}

model PrivacyConsent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  purpose       String
  policyVersion String   @map("policy_version")
  granted       Boolean
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  user          AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt(sort: Desc)], map: "idx_privacy_consents_user")
  @@map("privacy_consents")
}

model Notification {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  channel        String
  templateKey    String   @map("template_key")
  payload        Json     @default("{}")
  status         String   @default("queued")
  idempotencyKey String   @unique @map("idempotency_key")
  scheduledAt    DateTime @default(now()) @map("scheduled_at") @db.Timestamptz
  sentAt         DateTime? @map("sent_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  user           AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt], map: "idx_notifications_queue")
  @@map("notifications")
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user             AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}
