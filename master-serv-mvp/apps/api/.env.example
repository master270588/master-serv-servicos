PORT=3000
# Lista de origens autorizadas, separadas por vírgula. Ex.: http://localhost:3001
# Em produção, informe somente os domínios oficiais da MASTER SERV.
CORS_ORIGINS=http://localhost:3001
DATABASE_URL="postgresql://master_serv_dev:SENHA_FORTE_AQUI@localhost:5432/master_serv?schema=public"

# Gere um segredo aleatório com pelo menos 32 caracteres. Nunca use o valor de exemplo em produção.
JWT_ACCESS_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
