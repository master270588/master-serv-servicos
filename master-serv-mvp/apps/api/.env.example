PORT=3000
# Lista de origens autorizadas, separadas por vírgula. Ex.: http://localhost:3001
# Em produção, informe somente os domínios oficiais da MASTER SERV.
CORS_ORIGINS=http://localhost:3001
DATABASE_URL="postgresql://master_serv_dev:SENHA_FORTE_AQUI@localhost:5432/master_serv?schema=public"

# Gere um segredo aleatório com pelo menos 32 caracteres. Nunca use o valor de exemplo em produção.
JWT_ACCESS_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES

# Cloudflare R2 (compatível com API S3). Valores de exemplo; não são credenciais válidas.
# Criar bucket privado e credenciais com permissões mínimas. Nunca enviar chaves ao Git.
S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=master-serv-private
S3_ACCESS_KEY_ID=SUBSTITUA_POR_ACCESS_KEY
S3_SECRET_ACCESS_KEY=SUBSTITUA_POR_SECRET_KEY
S3_FORCE_PATH_STYLE=true

# Limite inicial planejado por arquivo: 10 MiB. A API deverá impor o limite também no servidor.
DOCUMENT_UPLOAD_MAX_BYTES=10485760

# ClamAV: serviço deve estar em rede privada, sem exposição pública.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
SCAN_BATCH_SIZE=10
