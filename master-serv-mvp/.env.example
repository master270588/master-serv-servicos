# Copie para .env na raiz do projeto. Use apenas valores locais de desenvolvimento.
# Nunca envie o arquivo .env ao Git.
POSTGRES_DB=master_serv
POSTGRES_USER=master_serv_dev
POSTGRES_PASSWORD=troque-por-uma-senha-local-forte-com-mais-de-24-caracteres
POSTGRES_PORT=5432

# Em execução local da API fora do Docker:
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# URL usada quando a API também roda dentro do Docker Compose (host PostgreSQL = postgres).
# Codifique caracteres especiais da senha como URL-encoding.
DATABASE_URL_DOCKER=postgresql://master_serv_dev:troque-esta-senha@postgres:5432/master_serv?schema=public
